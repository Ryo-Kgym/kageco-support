# Local OAuth callback: http://127.0.0.1:3000/freee/callback
APP_ORIGIN=http://127.0.0.1:3000
# Set freee OAuth credentials in .env.local or in the server environment.
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=

# Freee login session encryption key (32 random bytes, encoded as base64url).
SESSION_SECRET=
